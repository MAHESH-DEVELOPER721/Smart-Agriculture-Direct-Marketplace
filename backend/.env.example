# Database Configuration
# Local PostgreSQL format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
# Cloud PostgreSQL (Render / Supabase / Neon): postgresql+psycopg://...
# If unreachable or omitted, the application automatically uses local SQLite (sqlite:///./agrinexus.db)
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/agrinexus

# Security & Authentication (JWT Tokens)
SECRET_KEY=agridirect-smart-agriculture-secret-key-2026-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
